@@ -39,13 +39,13 @@ async fn main() {
     // 2. Démarrer le serveur HTTP Axum
     let router = api::build_router(app_state);
     
-    // On écoute sur toutes les interfaces réseau (0.0.0.0) sur le port 8080
-    let addr = "0.0.0.0:8080";
